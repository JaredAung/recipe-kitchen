# Worker (ECS) and Next (Vercel) read this file. Next maps SUPABASE_URL and
# SUPABASE_PUBLISHABLE_KEY to NEXT_PUBLIC_* for the browser.
# Keep SUPABASE_SECRET_KEY, SQS, and AWS keys on the server env only — never NEXT_PUBLIC_*.
GOOGLE_SPEECH_TO_TEXT_API_KEY=
ELEVENLABS_API_KEY=
GEMINI_API_KEY=
APIFY_API_TOKEN=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=
SUPABASE_STORAGE_BUCKET=
SQS_QUEUE_URL=
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
